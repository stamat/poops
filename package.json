{
  "name": "poops",
  "description": "Straightforward, no-bullshit bundler for the web.",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "poops.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamat/poops.git"
  },
  "bin": {
    "poops": "poops.js",
    "💩": "poops.js"
  },
  "files": [
    "poops.js",
    "lib/",
    "schema/",
    "!lib/**/__tests__/"
  ],
  "author": "Stamat <@stamat> (http://stamat.info)",
  "homepage": "https://github.com/stamat/poops",
  "private": false,
  "keywords": [
    "bundler",
    "javascript",
    "sass",
    "nunjucks",
    "liquid",
    "esbuild",
    "dart-sass",
    "tailwindcss",
    "toolchain-script",
    "static-site-generator"
  ],
  "peerDependencies": {
    "poops-images": ">=1.2.1",
    "postcss": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "poops-images": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ./poops.js -b",
    "lint": "eslint .",
    "lint:es": "es-check es2020 \"example/dist/js/*.js\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint:browsers": "stylelint --max-warnings 0 example/dist/css/styles.css"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "argoyle": "^1.0.0",
    "book-of-spells": "^1.4.0",
    "chokidar": "^5.0.0",
    "dayjs": "^1.11.19",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "highlight.js": "^11.11.1",
    "liquidjs": "^10.24.0",
    "marked": "^18.0.6",
    "marked-github-alerts": "^1.0.1",
    "marked-github-emoji": "^1.0.2",
    "marked-github-footnote": "^1.0.0",
    "nunjucks": "^3.2.4",
    "printstyle": "^1.0.0",
    "sass": "^1.63.4",
    "sass-path-resolver": "^1.0.2",
    "sass-token-importer": "^1.0.0",
    "unknown-keys": "^1.1.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@tailwindcss/postcss": "^4.2.1",
    "ajv": "^8.20.0",
    "es-check": "^9.6.4",
    "eslint": "^9.39.3",
    "jest": "^30.2.0",
    "neostandard": "^0.13.0",
    "poops-docs-theme": "^3.0.0",
    "postcss": "^8.5.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stylelint": "^17.14.1",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "sulphuris": "^4.0.0",
    "tailwindcss": "^4.2.1"
  },
  "overrides": {
    "nunjucks": {
      "chokidar": "$chokidar"
    }
  }
}
