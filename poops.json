{
  "$schema": "./schema/poops.schema.json",
  "scripts": [{
    "in": "example/src/js/main.ts",
    "out": "example/dist/js/scripts.js",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false,
      "format": "iife"
    }
  }, {
    "in": "example/src/js/react-app.jsx",
    "out": "example/dist/js/react-app.js",
    "options": {
      "sourcemap": true,
      "minify": true,
      "format": "iife"
    }
  }, {
    "in": "node_modules/poops-docs-theme/src/docs.ts",
    "out": "example/dist/js/docs.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife"
    }
  }],
  "reactor": [{
    "component": "example/src/js/App.jsx",
    "inject": "app_html",
    "in": "example/src/js/app-hydrate.jsx",
    "out": "example/dist/js/app-hydrate.js",
    "options": {
      "minify": true
    }
  }],
  "styles": [{
    "in": "example/src/scss/index.scss",
    "out": "example/dist/css/styles.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false,
      "tokenPaths": ["example/src/tokens"]
    }
  }, {
    "in": "node_modules/poops-docs-theme/scss/docs.scss",
    "out": "example/dist/css/docs.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }],
  "markup": {
    "in": "example/src/markup",
    "out": "example/dist",
    "options": {
      "site": {
        "title": "💩 Poops",
        "brand": "Poops",
        "description": "A niche bundler for design-driven micro-sites and blogs.",
        "url": "https://stamat.info/poops",
        "logo": "poop.png",
        "lang": "en",
        "repo": "https://github.com/stamat/poops",
        "branch": "main",
        "links": [
          { "title": "Docs", "url": "docs/" },
          { "title": "septic", "url": "https://stamat.info/septic" },
          { "title": "laxative", "url": "https://stamat.info/laxative" }
        ],
        "iconLinks": [
          { "title": "npm", "url": "https://www.npmjs.com/package/poops", "icon": "npm" }
        ]
      },
      "data": [
        "_data/features.yaml",
        "_data/links.json",
        "_data/poops.yaml"
      ],
      "includePaths": [
        "_layouts",
        "_partials"
      ],
      "dateFormat": "MMM D, YYYY",
      "searchIndex": "search-index.json",
      "sitemap": "sitemap.xml",
      "llms": {
        "out": "llms.txt",
        "intro": "example/src/llms-intro.md",
        "full": true,
        "fullIntro": "example/src/llms-intro-full.md"
      },
      "robots": "robots.txt",
      "nav": {
        "out": "nav.json",
        "root": "docs",
        "collections": "index"
      },
      "feed": {
        "collection": "changelog",
        "out": "changelog/feed.rss",
        "content": true
      }
    }
  },
  "copy": [
    {
      "in": ["example/src/static", "schema/poops.schema.json"],
      "out": "example/dist"
    }
  ],
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve" : {
    "port": 4040
  },
  "livereload": true,
  "watch": [
    "example/src"
  ],
  "includePaths": [
    "node_modules"
  ]
}
